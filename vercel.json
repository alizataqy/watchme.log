{
    "rewrites": [
        {
            "source": "/api/tvmaze/:path*",
            "destination": "/api/tvmaze"
        },
        {
            "source": "/api/tmdb/:path*",
            "destination": "/api/tmdb"
        },
        {
            "source": "/((?!api/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}